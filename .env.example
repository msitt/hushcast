# Deployment-shaped config (runtime knobs live in the web UI settings instead)

# Config volume: SQLite DB + settings (small; back this up)
HUSHCAST_CONFIG_DIR=./config

# Data volume: audio files, transcripts, scratch space (bulky; replaceable)
HUSHCAST_DATA_DIR=./data

# External base URL used to build the feed/enclosure URLs podcast clients see.
# Must match how your reverse proxy exposes the app.
HUSHCAST_PUBLIC_URL=http://localhost:4874

# Listen port inside the container (Docker only; bare-metal runs pass --port
# to uvicorn directly)
HUSHCAST_PORT=4874

# Web UI / API auth. Enabled by default: the first visit to the UI creates the
# login (username + password, changeable later in Settings). Set to "disabled"
# ONLY if something in front of the app (e.g. reverse-proxy auth) already
# protects it. Served feeds under /p/* are always token-gated instead.
#HUSHCAST_AUTH=disabled

# Debug override only: forces the log level and locks the UI control on the
# System page. Leave unset — the level is normally changed from the UI.
#HUSHCAST_LOG_LEVEL=DEBUG
